        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "tableType": "spans",
          "query": "{resource.service.name = \"rl_insight_monitor\" && span.\"monitor.trace_segment\" = \"metric_log\" && span.project =~ `^${project:regex}$` && span.experiment_name =~ `^${execution:regex}$` && span.\"metric.name\" = \"sft_train/loss\" && span.global_step != nil && span.\"metric.value\" != nil} | select(span.global_step, span.\"metric.value\")",
          "limit": 1000,
          "spss": 100
        }
      ],
      "transformations": [
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "global_step",
                "destinationType": "number"
              },
              {
                "targetField": "metric.value",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "global_step",
                "desc": false
              }
            ]
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "global_step",
                "destinationType": "string"
              }
            ]
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(global_step|metric\\.value)$"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "displayName": "sft_train/loss",
